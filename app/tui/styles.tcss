Screen {
    background: #0f1117;
    color: #d9dee7;
}

#root {
    layout: grid;
    grid-size: 3 2;
    grid-columns: 28 1fr 30;
    grid-rows: 1fr 8;
    height: 1fr;
}

#sidebar,
#stream-panel,
#detail-panel,
#status-panel {
    border: round #2d3441;
    background: #171b23;
}

#sidebar {
    row-span: 2;
    padding: 1 1;
}

#stream-panel,
#detail-panel {
    padding: 0 1;
}

#detail-panel {
    row-span: 2;
}

#status-panel {
    padding: 0 1;
}

.panel-title {
    color: #92a8c7;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

.block-label {
    color: #92a8c7;
    margin-top: 1;
}

Input,
Select,
TextArea {
    margin-bottom: 1;
}

TextArea {
    height: 8;
}

Checkbox {
    margin-bottom: 1;
}

Button {
    width: 1fr;
    margin-bottom: 1;
}

.action-row {
    layout: horizontal;
    height: auto;
}

.action-row Button {
    margin-right: 1;
}

#event-log {
    height: 1fr;
    background: #11141b;
    border: none;
}

#detail-tabs {
    height: 1fr;
}

.detail-view {
    padding: 0 1;
    overflow: auto auto;
}

#status-line {
    height: 1fr;
    min-width: 10;
    content-align: left middle;
    color: #aeb9ca;
}
